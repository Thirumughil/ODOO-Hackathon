PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=subscriptiq

JWT_SECRET=YOUR_LONG_RANDOM_SECRET_KEY
JWT_ACCESS_EXPIRES_IN=15m
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

FRONTEND_URL=http://localhost:5173
